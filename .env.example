# ==============================================================================
# RouteIQ Online API Model Keys (Optional)
# If left blank, RouteIQ seamlessly routes using local Apple Silicon GGUF models
# or high-fidelity deterministic simulation without failing!
# ==============================================================================

# Groq Cloud (Llama 3.3 70B Versatile - Ultra-fast LPU inference)
# Obtain free API key at: https://console.groq.com/keys
GROQ_API_KEY=

# Google AI Studio (Gemini 1.5 Flash - 1,000,000 Token Context Window)
# Obtain free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenRouter (Llama 3.2 3B Instruct - Free tier access)
# Obtain API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenAI (GPT-4o Mini - High-speed cost-effective frontier intelligence)
# Obtain API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# DeepSeek Cloud (DeepSeek V3 Official API - State-of-the-art coding and reasoning)
# Obtain API key at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Anthropic Claude (Claude 3.5 Sonnet - Frontier Reference Model)
# Obtain API key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=
